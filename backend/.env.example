# Copy to .env and fill in. NEVER commit the real .env file.

# demo = no real auth or AI. Phase 2+ uses real providers.
APP_ENV=demo
OWNER_NAME=the owner

# --- Authentication (Phase 2) ---
# Firebase project id used to verify ID tokens. No service account key is stored in git.
FIREBASE_PROJECT_ID=

# --- AI provider (Phase 2) ---
AI_PROVIDER=mock
AI_API_KEY=

# --- Calls (Phase 4) ---
CALL_PROVIDER=mock
TWILIO_AUTH_TOKEN=
# Public wss:// address of this backend, e.g. wss://your-host/ws/conversation-relay
PUBLIC_WS_URL=
# Public https:// base address of this backend (no trailing slash). Twilio signs the exact URL it calls.
PUBLIC_WEBHOOK_URL=

# --- Safety ---
RATE_LIMIT_PER_MINUTE=30
RECORDING_ENABLED=false
